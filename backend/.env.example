# Lokal ishga tushirish uchun SQLite. PostgreSQL ishlatsangiz DATABASE_URL ni almashtiring.
DATABASE_URL=sqlite:///./unum_savdo.db
# Misol PostgreSQL:
# DATABASE_URL=postgresql://postgres:PAROL@localhost:5432/unum_savdo

SECRET_KEY=change-this-to-a-long-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440
FRONTEND_ORIGIN=http://localhost:3000

# Telegram Web Login. Bot serveri ishlamaydi.
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
TELEGRAM_REDIRECT_URI=http://127.0.0.1:8000/api/auth/telegram/callback

# Lokal test uchun true. Productionda false qiling.
DEV_MODE=true
